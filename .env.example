# 仅为配置示例，请复制为 .env 并替换所有占位值；不要提交 .env。
DB_NAME=lab_booking
DB_USERNAME=lab_booking
DB_PASSWORD=replace-with-a-strong-database-password
JWT_SECRET=replace-with-at-least-32-random-bytes-of-entropy
BACKUP_ENCRYPTION_KEY=replace-with-a-different-secret-of-at-least-32-characters
CORS_ALLOWED_ORIGINS=https://labs.example.edu.cn
SPRING_PROFILES_ACTIVE=prod
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_PER_MINUTE=600
LOGIN_RATE_LIMIT_MAX_PER_MINUTE=30
PUBLIC_HTTP_PORT=8088
PUBLIC_HTTPS_PORT=8443
POSTGRES_DEV_PORT=5432
TLS_CERT_DIRECTORY=./deploy/certs
